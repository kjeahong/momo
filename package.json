{
  "name": "momo",
  "version": "0.1.0",
  "description": "Momo - Smart Note App with Korean Trigram FTS5 & Image OCR Search",
  "main": "src/electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "app": "electron .",
    "dist": "npm run build && electron-builder --win --dir",
    "pack": "electron-builder --win --dir"
  },
  "build": {
    "appId": "com.momo.notes",
    "productName": "Momo",
    "executableName": "Momo",
    "asar": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "src/server/**/*",
      "src/electron/**/*",
      "build/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "portable": {
      "artifactName": "Momo-Portable.exe"
    }
  },
  "keywords": [
    "joplin",
    "notes",
    "markdown",
    "search",
    "fts5",
    "ocr",
    "desktop-app"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "lucide-react": "^0.475.0",
    "marked": "^15.0.7",
    "multer": "^1.4.5-lts.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sql.js": "^1.15.1",
    "tailwind-merge": "^3.0.2",
    "tesseract.js": "^6.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
